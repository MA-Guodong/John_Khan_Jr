# 服务端口
PORT=4000
HOST=0.0.0.0

# SQLite 数据文件（相对路径按 server/ 目录解析，也可写绝对路径）
DATABASE_FILE=./data/khan.db
# 种子 JSON 目录
SEED_DIR=../data/seed
# 前端构建产物目录
WEB_DIST=../web/dist
# 头像原图目录（Python 爬虫写入、Node 直接托管）
AVATAR_DIR=../web/public/images

# 日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# 允许跨域的来源，多个用英文逗号分隔；同源请求始终放行
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 部署在反向代理后面时设为 true，用于读取真实 IP / 协议
TRUST_PROXY=false
