# 数据库文件：与 Node 服务共用，相对路径按 python/ 目录解析
KHAN_DB_PATH=../server/data/khan.db
# 头像原图目录：Node 会直接托管这个目录，新增图片无需重新构建前端
KHAN_AVATAR_DIR=../web/public/images

# UP 主 mid
KHAN_MID=23947287

# 可选：B 站登录 Cookie（视频接口被风控时必填）
# 从浏览器开发者工具 → Network → 任意请求的 Cookie 复制整行
KHAN_COOKIE=

KHAN_HTTP_TIMEOUT=15
KHAN_RETRIES=3
KHAN_REQUEST_DELAY=1.0
KHAN_VIDEO_PAGE_SIZE=20
KHAN_LOG_LEVEL=INFO

# 仅 migrate_from_mysql.py 使用
KHAN_MYSQL_HOST=127.0.0.1
KHAN_MYSQL_PORT=3306
KHAN_MYSQL_USER=root
KHAN_MYSQL_PASSWORD=
KHAN_MYSQL_DATABASE=John_Khan_Jr
KHAN_MYSQL_CHARSET=utf8mb4
